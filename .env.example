# Optional: only needed for the original Tinker training path (scripts/ + notebooks).
TINKER_API_KEY=

# Optional: Weights & Biases logging for main_pytorch.py (falls back to local JSON).
WANDB_API_KEY=

# Optional: push LoRA adapters / rollout datasets to the HuggingFace Hub.
HF_TOKEN=

# tau2-bench RL: user simulator + judge over the Llama-API passthrough.
# Must be an `LLM|<id>|<secret>` Llama-API key (minted at
# metagen-llm-api-keys.nest.x2p.facebook.net) linked to an `mg-api-...` entitlement
# that allowlists the target model. A bare `mg-api-...` key returns HTTP 401.
LLAMA_API_KEY=
