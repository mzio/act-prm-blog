export BASH_FUNC_ml%%=() {  eval "$($LMOD_DIR/ml_cmd "$@")"
export }
export BASH_FUNC_which%%=() {  ( alias;
export  eval ${which_declare} ) | /usr/bin/which --tty-only --read-alias --read-functions --show-tilde --show-dot $@
export }
export BASH_FUNC_module%%=() {  if [ -z "${LMOD_SH_DBG_ON+x}" ]; then
export  case "$-" in 
export  *v*x*)
export  __lmod_sh_dbg='vx'
export  ;;
export  *v*)
export  __lmod_sh_dbg='v'
export  ;;
export  *x*)
export  __lmod_sh_dbg='x'
export  ;;
export  esac;
export  fi;
export  if [ -n "${__lmod_sh_dbg:-}" ]; then
export  set +$__lmod_sh_dbg;
export  echo "Shell debugging temporarily silenced: export LMOD_SH_DBG_ON=1 for Lmod's output" 1>&2;
export  fi;
export  eval "$($LMOD_CMD shell "$@")" && eval "$(${LMOD_SETTARG_CMD:-:} -s sh)";
export  __lmod_my_status=$?;
export  if [ -n "${__lmod_sh_dbg:-}" ]; then
export  echo "Shell debugging restarted" 1>&2;
export  set -$__lmod_sh_dbg;
export  fi;
export  unset __lmod_sh_dbg;
export  return $__lmod_my_status
export }
